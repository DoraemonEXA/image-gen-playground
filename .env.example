APP_MODE=multi-user
APP_ORIGIN=https://images.example.com
OPENAI_API_KEY=
# Optional; omit to use OpenAI directly.
OPENAI_API_BASE_URL=https://api.openai.com/v1
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_KEY=
MAX_ACTIVE_PER_USER=1
MAX_ACTIVE_GLOBAL=4
# Local development only (Compose supplies /data):
APP_DATA_DIR=./data
# Only true when the application is reachable exclusively through the supplied proxy.
TRUST_PROXY=false
