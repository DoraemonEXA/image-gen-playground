APP_MODE=multi-user
APP_ORIGIN=https://images.example.com
OPENAI_API_KEY=
# Optional; omit to use OpenAI directly.
OPENAI_API_BASE_URL=https://api.openai.com/v1
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_KEY=
MAX_ACTIVE_PER_USER=1
MAX_ACTIVE_GLOBAL=4
# Opt in only if your provider guarantees no charge for initial parameter validation rejections.
# Applies to a narrow HTTP 400 code/parameter allowlist, never timeouts, 5xx or missing usage.
AUTO_RECONCILE_INVALID_REQUESTS=false
# Multi-user image/history retention in days; 0 disables automatic deletion.
IMAGE_RETENTION_DAYS=30
# Local development only. On Railway, set APP_DATA_DIR to the absolute volume
# mount path (normally /data). Copying ./data into Railway resolves to /app/data.
# With the current non-root Docker image, Railway also requires RAILWAY_RUN_UID=0
# unless volume ownership is prepared separately. Compose supplies /data.
APP_DATA_DIR=./data
# Only true when the application is reachable exclusively through the supplied proxy.
TRUST_PROXY=false
# Enable remote MCP tools and OAuth using the existing OTP accounts (multi-user only).
MCP_ENABLED=false
